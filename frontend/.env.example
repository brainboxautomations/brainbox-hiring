# Placeholders only — never put real secrets in this file (it is committed).
# Copy to .env.local and fill in real values for local dev (docs/development.md).
# For a real deployment, set these in your host's environment instead; the full
# table, with which ones are required, is in docs/self-hosting.md.
# Rules:
#  - No secrets in NEXT_PUBLIC_* (they ship to the browser bundle)
#  - Read env only via configurations/env-configuration.ts (Zod-validated),
#    never process.env directly.

# --- Supabase (auth) ---------------------------------------------------------
# Project URL and public anon key from the Supabase dashboard:
#   Project Settings → API → "Project URL" and "Project API keys → anon public".
# The anon key is safe to expose to the browser; row-level security is what
# protects your data, so keep RLS enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend API -------------------------------------------------------------
# The internal API is served by Next.js Route Handlers in THIS app (app/api/**),
# talking to Supabase server-side — there is no separate backend service.
# Base URL for the client's calls; leave blank to default to "/api" (same origin),
# which is right for every normal deployment.
NEXT_PUBLIC_API_BASE_URL=

# --- Email (Resend) ----------------------------------------------------------
# Server-side only. NEVER prefix with NEXT_PUBLIC_ — this key can send mail as
# your verified domain. Read via configurations/env-configuration.ts serverEnv(),
# which is validated lazily so the browser bundle and `npm run build` do not
# need it. Required at runtime: besides sending email, the careers page, the
# apply form and the questionnaire submit do not load without it. For local
# development any placeholder (e.g. re_local_placeholder) is enough.
# Get it from: Resend dashboard → API Keys.
RESEND_API_KEY=

# The masked relay address every outbound email is sent from, e.g.
# talent@hiring.example.com. The display name is the logged-in user's, the
# address is always this one, so a recipient never learns a team member's real
# mailbox and every reply comes back through the relay for the inbound webhook.
# Must be on a domain verified in Resend. Required to send email: there is no
# default, and while it is blank every send is refused with a "not configured"
# error (503) instead of going out from someone else's address. The careers
# page also shows it as the contact address when no role is open.
EMAIL_RELAY_ADDRESS=

# --- Inbound email -----------------------------------------------------------
# The signing secret for the Resend webhook that delivers `email.received`.
# Get it from the Resend dashboard:
#   Webhooks → your endpoint (POST https://<host>/api/webhooks/resend/inbound,
#   subscribed to `email.received`) → "Signing Secret". It starts with `whsec_`.
# The webhook is a public, unauthenticated endpoint by design — the relay has no
# session — so this signature is the ONLY thing distinguishing Resend from
# anyone else who finds the URL. Leave it blank and the endpoint answers 503 to
# every request: it fails closed, never open.
RESEND_WEBHOOK_SECRET=

# Supabase service-role key, used by the inbound webhook, the two workers
# (automation queue and upload clean-up) and adding team members in
# Settings → Users, and nothing else. The webhook and the workers carry no user
# session, so they cannot use the anon client (RLS denies it), and there is no
# SECURITY DEFINER function they could call without also exposing that surface
# to `anon`. Creating a login needs the Auth admin API.
# Get it from: Project Settings → API → "Project API keys → service_role".
# It bypasses RLS entirely. Server-side only, never NEXT_PUBLIC_, never in the
# browser bundle, and never in a file that is committed.
# Blank means inbound mail cannot be stored, no stage action can fire and no
# team member can be added; those endpoints answer 503.
SUPABASE_SERVICE_ROLE_KEY=

# --- Automation worker -------------------------------------------------------
# Shared secret between the pg_cron job and POST /api/workers/scheduled-actions.
# The database has no user session, so this header is the only thing separating
# the queue worker from anyone who finds the URL. Blank means the endpoint
# answers 503 to everything: it fails closed, exactly like the inbound webhook.
#
# Set it here AND in the database, which is where pg_cron reads it from:
#
#   update automation_worker_config
#      set endpoint_url  = 'https://<your-host>/api/workers/scheduled-actions',
#          shared_secret = '<the same value as below>',
#          enabled       = true;
#
# That row ships blank and disabled, so a restored database never starts POSTing
# to whatever host the previous one pointed at. Until it is filled in the cron
# job runs every minute and does nothing, and no stage action ever fires.
# The worker also needs SUPABASE_SERVICE_ROLE_KEY above — it runs without a user.
AUTOMATION_WORKER_SECRET=

# --- Captcha on the public forms (Cloudflare Turnstile) -----------------------
# Shown on the apply form and the hosted questionnaire; the server verifies the
# token before accepting a submission. Free: Cloudflare dashboard → Turnstile →
# Add widget, with this site's domain. Set BOTH or NEITHER — blank skips the
# captcha (the rate limits still apply). Cloudflare's always-pass test keys for
# local development: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Company identity --------------------------------------------------------
# The hiring company candidates see. Server-side only, read at request time, so
# a change needs a redeploy but not a rebuild. Nothing defaults to any real
# company; set at least COMPANY_NAME and COMPANY_WEBSITE_URL.
#
# COMPANY_NAME         {{company.name}} in emails, the sender name of automated
#                      emails when a position sets none, and the careers pages'
#                      header, footer and titles. Blank leaves {{company.name}}
#                      empty, sends automated emails under the bare relay
#                      address, and the careers pages use neutral wording.
# COMPANY_WEBSITE_URL  The company's own site, linked from the careers header
#                      and footer, e.g. https://www.example.com. Blank hides
#                      the link.
# COMPANY_LOGO_URL     Optional. The image shown in the careers header, about
#                      32px tall. Either an http(s) URL, e.g.
#                      https://cdn.example.com/logo.png, or a path starting
#                      with a single /, e.g. /logo.png, for a file you put in
#                      frontend/public/ (it ships with the build, so adding
#                      the file needs a rebuild). Blank shows COMPANY_NAME as
#                      text.
# COMPANY_CAREERS_URL  {{company.careers_url}}, e.g. https://jobs.example.com/careers.
#                      Blank leaves the merge variable empty.
# COMPANY_WEBSITE_URL and COMPANY_CAREERS_URL must be http or https.
COMPANY_NAME=
COMPANY_WEBSITE_URL=
COMPANY_LOGO_URL=
COMPANY_CAREERS_URL=

# --- Hosted questionnaire links ----------------------------------------------
# The public origin this app is served from. It is the base of every hosted
# questionnaire link the automation worker emails: <APP_BASE_URL>/q/<token>.
# Blank falls back to the origin of COMPANY_CAREERS_URL, which is correct
# whenever the careers pages and the app share a host — set this only when they
# do not. A scheme other than http/https is refused, and with neither value set
# `send_questionnaire` settles `skipped` with the reason rather than mailing a
# broken link.
APP_BASE_URL=

# --- Integration tests (L3) --------------------------------------------------
# Optional. Read only by `npm run test:integration`. The usual way to run L3 is
# `npm run test:integration:local`, against the throwaway local Supabase stack
# from `npm run db:start`; it needs nothing in this file. L3 signs a throwaway
# user in. Leave blank and the suite generates its own credentials per run; set
# them to reuse a fixed account.
# The suite never sends real email — the Resend transport is mocked.
L3_TEST_EMAIL=
L3_TEST_PASSWORD=

# --- Database tests (L3 / L4 against a hosted project) -----------------------
# Optional, and not needed for the `:local` scripts, which use the local stack's
# public defaults. Read only by `npm run test:integration` and `npm run test:db`
# when you point them at a hosted development project; never by the app, and
# never bundled. A Postgres connection string INCLUDING the password, so treat
# it as a secret — it is a full-privilege credential. Leave blank and
# `npm run test:db` falls back to the Supabase CLI's linked project, which
# needs no password.
# Setup instructions: docs/development.md, "Optional: against a hosted project".
SUPABASE_DB_URL=

# --- File storage (Cloudflare R2) --------------------------------------------
# Every uploaded file (resumes, video answers, email attachments) lives in one
# private R2 bucket per environment, under the folders resumes/, videos/ and
# message-attachments/. Server-side only; never prefix with NEXT_PUBLIC_.
#   R2_ACCOUNT_ID         Cloudflare dashboard → R2 → Account details → Account ID
#   R2_ACCESS_KEY_ID      R2 → Manage API tokens → a token with "Object Read & Write"
#   R2_SECRET_ACCESS_KEY    scoped to this environment's bucket only
#   R2_BUCKET             e.g. ats-staging or ats-prod
# The bucket needs a CORS rule allowing GET and PUT, with the Content-Type
# header, from the app's origin, because browsers upload to and preview from R2
# directly. docs/self-hosting.md has the policy. Without all four values,
# uploads (including résumés on the apply form), previews and attachments fail.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
