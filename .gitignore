# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Paths here are deliberately UNANCHORED (no leading slash) so they match at any
# depth. The repo root holds `frontend/`, `supabase/` and `docs/`, and build
# artefacts live inside those — a root-anchored `/node_modules` would not match
# `frontend/node_modules`.

# dependencies (npm only: package-lock.json is the lockfile Amplify installs from)
node_modules/
pnpm-lock.yaml
yarn.lock
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
# Playwright artifacts (the Playwright MCP browser writes to .playwright-mcp/)
test-results/
playwright-report/
playwright/.cache/
blob-report/
.playwright-mcp/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and per-machine npm settings (can opt-in for committing if needed)
.env*
.npmrc
!.env.example
!.env.development.local.example
!.env.promote.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state (a slash mid-pattern anchors it to the root, hence **/;
# running the CLI from frontend/ creates frontend/supabase/.temp/)
**/supabase/.branches/
**/supabase/.temp/

# Claude Code local config (ignore everything under .claude, and per-machine MCP servers)
.claude/
.mcp.json

# Spec Kit working files
.specify/
/specs/

# Local Claude Code instructions (not tracked)
CLAUDE.md
AGENTS.md

# Local demo recordings
docs/demo/
