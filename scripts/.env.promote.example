# Config for scripts/promote.sh. Copy to scripts/.env.promote (gitignored)
# and fill it in. promote.sh sources it as bash. A variable already exported
# in your shell wins over the value here.

# Required unless you pass --skip-db: your PRODUCTION Supabase project ref
# (the <ref> in https://<ref>.supabase.co). promote.sh refuses a PROD_DB_URL
# that does not contain it, so it cannot migrate the wrong database.
EXPECTED_PROD_DB_REF=

# Remote and branch that dev work lands on. Default: origin / main.
# DEV_REMOTE=origin
# DEV_BRANCH=main

# Remote and branch of the private prod repo your prod host builds from.
# Default: prod / main.
# PROD_REMOTE=prod
# PROD_BRANCH=main

# GitHub repo (<owner>/<name>) whose CI must have passed on the commit being
# promoted. Default: read from the DEV_REMOTE URL.
# DEV_REPO=<owner>/<repo>

# Name of the GitHub Actions workflow to check. Default: CI.
# CI_WORKFLOW=CI

# Where prod database backups are written before each migration.
# Default: $HOME/prod-db-backups.
# PROMOTE_BACKUP_DIR="$HOME/prod-db-backups"
